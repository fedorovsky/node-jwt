# HTTP client requests (JetBrains / VS Code REST Client).
# Run "Auth - Register" first: it stores email, password and token as globals.

@host = http://localhost:3000

### Health
GET {{host}}/health

### Auth - Register
< {%
    request.variables.set("email", `user${Math.floor(Math.random() * 100000)}@example.com`);
    request.variables.set("password", `Passw0rd-${Date.now()}`);
%}
POST {{host}}/auth/register
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
    client.test("registered", () => client.assert(response.status === 201));
    client.global.set("email", request.variables.get("email"));
    client.global.set("password", request.variables.get("password"));
    client.global.set("token", response.body.token);
%}

### Auth - Register (duplicate → 409)
POST {{host}}/auth/register
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Auth - Register (invalid payload → 400)
POST {{host}}/auth/register
Content-Type: application/json

{
  "email": "not-an-email",
  "password": "123"
}

### Auth - Login
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
    client.test("logged in", () => client.assert(response.status === 200));
    client.global.set("token", response.body.token);
%}

### Auth - Login (wrong password → 401)
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "wrong-password"
}

### Auth - Check email
POST {{host}}/auth/check-email
Content-Type: application/json

{
  "email": "{{email}}"
}

### Auth - Validate & renew token
POST {{host}}/auth/validate-token
Authorization: Bearer {{token}}

> {%
    client.global.set("token", response.body.token);
%}

### Users - Me (protected)
GET {{host}}/users/me
Authorization: Bearer {{token}}

### Users - Me without token (→ 401)
GET {{host}}/users/me

### Users - All
GET {{host}}/users/all

### Protected demo route
GET {{host}}/protected
Authorization: Bearer {{token}}

### Users - Remove all (destructive!)
DELETE {{host}}/users/remove-all

###
