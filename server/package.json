{
  "name": "node-jwt",
  "version": "1.0.0",
  "description": "Express + JWT authentication API backed by SQLite",
  "main": "src/server.mjs",
  "type": "module",
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "migrate": "knex migrate:latest --knexfile ./knexfile.cjs",
    "migrate:make": "knex migrate:make --knexfile ./knexfile.cjs",
    "migrate:rollback": "knex migrate:rollback --knexfile ./knexfile.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@faker-js/faker": "^9.3.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "jose": "^5.9.6",
    "knex": "^3.1.0",
    "morgan": "^1.10.0",
    "sqlite3": "^5.1.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "prettier": "3.4.2"
  },
  "engines": {
    "node": ">=20"
  }
}
